{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rombridge.birb.homes/contracts/runtime-api.schema.json",
  "title": "ROM Operator Bridge Runtime API",
  "description": "Canonical schema_version 1 UI/service contract. Service and UI code must derive or validate public runtime payloads from this file.",
  "oneOf": [
    { "$ref": "#/$defs/errorEnvelope" },
    { "$ref": "#/$defs/healthResponse" },
    { "$ref": "#/$defs/sessionResponse" },
    { "$ref": "#/$defs/startSessionRequest" },
    { "$ref": "#/$defs/startSessionResponse" },
    { "$ref": "#/$defs/stopSessionRequest" },
    { "$ref": "#/$defs/stopSessionResponse" },
    { "$ref": "#/$defs/runStatusResponse" },
    { "$ref": "#/$defs/validationStatusResponse" },
    { "$ref": "#/$defs/sessionOnlyRequest" },
    { "$ref": "#/$defs/runStateResponse" },
    { "$ref": "#/$defs/frameCurrentResponse" },
    { "$ref": "#/$defs/captureTriggerRequest" },
    { "$ref": "#/$defs/captureTriggerResponse" },
    { "$ref": "#/$defs/captureJobResponse" },
    { "$ref": "#/$defs/captureRecentResponse" },
    { "$ref": "#/$defs/captureDetailResponse" },
    { "$ref": "#/$defs/captureFeaturesResponse" },
    { "$ref": "#/$defs/labelsRequest" },
    { "$ref": "#/$defs/labelsResponse" },
    { "$ref": "#/$defs/labelsSnapshotResponse" },
    { "$ref": "#/$defs/wsEnvelope" }
  ],
  "$defs": {
    "schemaName": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "rfc3339": {
      "type": "string",
      "format": "date-time"
    },
    "u64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Schema v1 transports frame counters and sequence numbers as JSON safe integers. The service may keep wider u64 values internally."
    },
    "hashRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "backendMode": {
      "type": "string",
      "enum": ["synthetic", "real"]
    },
    "sessionState": {
      "type": "string",
      "enum": [
        "idle",
        "starting",
        "running",
        "paused",
        "capture_pending",
        "stopping",
        "stopped",
        "faulted"
      ]
    },
    "validationStatus": {
      "type": "string",
      "enum": ["not_run", "running", "passed", "failed"]
    },
    "capabilityName": {
      "type": "string",
      "enum": [
        "input",
        "preview",
        "capture",
        "labels",
        "privileged_features",
        "validation_runner"
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "preview",
        "capture",
        "labels",
        "privileged_features",
        "validation_runner"
      ],
      "properties": {
        "input": { "type": "boolean" },
        "preview": { "type": "boolean" },
        "capture": { "type": "boolean" },
        "labels": { "type": "boolean" },
        "privileged_features": { "type": "boolean" },
        "validation_runner": { "type": "boolean" }
      }
    },
    "padLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout_id", "layout_version"],
      "properties": {
        "layout_id": { "const": "console16-12btn-v1" },
        "layout_version": { "const": 1 }
      }
    },
    "errorCode": {
      "type": "string",
      "enum": [
        "auth_rejected",
        "origin_rejected",
        "session_inactive",
        "session_active_elsewhere",
        "backend_unavailable",
        "frame_stale",
        "frame_unavailable",
        "capture_in_progress",
        "capture_failed",
        "label_conflict",
        "validation_failed",
        "bad_request"
      ]
    },
    "errorObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "details"],
      "properties": {
        "code": { "$ref": "#/$defs/errorCode" },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "retryable": { "type": "boolean" },
        "details": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean", "null"]
          }
        }
      }
    },
    "errorEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "error"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "error": { "$ref": "#/$defs/errorObject" }
      }
    },
    "healthResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "ok", "service_version", "backend_mode", "runtime_api"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "ok": { "type": "boolean" },
        "service_version": { "type": "string", "minLength": 1 },
        "backend_mode": { "$ref": "#/$defs/backendMode" },
        "runtime_api": { "const": 1 }
      }
    },
    "sessionResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "active",
            "session_id",
            "run_id",
            "state",
            "current_frame",
            "backend_mode"
          ],
          "properties": {
            "schema_version": { "$ref": "#/$defs/schemaVersion" },
            "active": { "const": true },
            "session_id": { "$ref": "#/$defs/id" },
            "run_id": { "$ref": "#/$defs/id" },
            "state": { "$ref": "#/$defs/sessionState" },
            "current_frame": { "$ref": "#/$defs/u64" },
            "backend_mode": { "$ref": "#/$defs/backendMode" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "active", "state"],
          "properties": {
            "schema_version": { "$ref": "#/$defs/schemaVersion" },
            "active": { "const": false },
            "state": { "const": "idle" }
          }
        }
      ]
    },
    "startSessionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "backend_mode",
        "requested_capabilities"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "backend_mode": { "$ref": "#/$defs/backendMode" },
        "requested_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capabilityName" }
        }
      }
    },
    "startSessionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "session_id",
        "run_id",
        "state",
        "current_frame",
        "pad_layout",
        "capabilities"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "session_id": { "$ref": "#/$defs/id" },
        "run_id": { "$ref": "#/$defs/id" },
        "state": { "$ref": "#/$defs/sessionState" },
        "current_frame": { "$ref": "#/$defs/u64" },
        "pad_layout": { "$ref": "#/$defs/padLayout" },
        "capabilities": { "$ref": "#/$defs/capabilities" }
      }
    },
    "stopSessionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "session_id", "reason"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "session_id": { "$ref": "#/$defs/id" },
        "reason": {
          "type": "string",
          "enum": ["operator_stop", "fault_cleanup", "session_replaced"]
        }
      }
    },
    "stopSessionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "session_id", "state", "final_frame"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "session_id": { "$ref": "#/$defs/id" },
        "state": { "const": "stopped" },
        "final_frame": { "$ref": "#/$defs/u64" }
      }
    },
    "runStatusResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "session_id",
        "run_id",
        "state",
        "backend_mode",
        "current_frame",
        "last_applied_input_frame",
        "last_preview_frame",
        "preview_stale",
        "active_capture_job_id",
        "capabilities"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "session_id": { "$ref": "#/$defs/id" },
        "run_id": { "$ref": "#/$defs/id" },
        "state": { "$ref": "#/$defs/sessionState" },
        "backend_mode": { "$ref": "#/$defs/backendMode" },
        "current_frame": { "$ref": "#/$defs/u64" },
        "last_applied_input_frame": { "$ref": "#/$defs/u64" },
        "last_preview_frame": { "$ref": "#/$defs/u64" },
        "preview_stale": { "type": "boolean" },
        "active_capture_job_id": {
          "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        },
        "capabilities": { "$ref": "#/$defs/capabilities" }
      }
    },
    "validationStatusResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "command_class",
        "started_at",
        "completed_at",
        "summary",
        "issue_summaries"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "status": { "$ref": "#/$defs/validationStatus" },
        "command_class": {
          "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        },
        "started_at": {
          "oneOf": [{ "$ref": "#/$defs/rfc3339" }, { "type": "null" }]
        },
        "completed_at": {
          "oneOf": [{ "$ref": "#/$defs/rfc3339" }, { "type": "null" }]
        },
        "summary": {
          "type": "string",
          "maxLength": 240
        },
        "issue_summaries": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "sessionOnlyRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "session_id"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "session_id": { "$ref": "#/$defs/id" }
      }
    },
    "runStateResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "state", "current_frame"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "state": { "$ref": "#/$defs/sessionState" },
        "current_frame": { "$ref": "#/$defs/u64" }
      }
    },
    "frameCurrentResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "frame",
        "captured_at",
        "stale",
        "width",
        "height",
        "format",
        "image_url",
        "preview_hash"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "frame": { "$ref": "#/$defs/u64" },
        "captured_at": { "$ref": "#/$defs/rfc3339" },
        "stale": { "type": "boolean" },
        "width": { "const": 256 },
        "height": { "const": 224 },
        "format": { "const": "image/png" },
        "image_url": { "type": "string", "pattern": "^/api/frame/current/image" },
        "preview_hash": { "$ref": "#/$defs/hashRef" }
      }
    },
    "captureStatus": {
      "type": "string",
      "enum": ["requested", "capturing", "completed", "failed", "not_labelable"]
    },
    "captureTriggerRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "session_id",
        "idempotency_key",
        "observed_preview_frame",
        "reason"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "session_id": { "$ref": "#/$defs/id" },
        "idempotency_key": { "$ref": "#/$defs/uuid" },
        "observed_preview_frame": { "$ref": "#/$defs/u64" },
        "reason": { "enum": ["operator_mark"] }
      }
    },
    "captureTriggerResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "job_id",
        "status",
        "requested_frame",
        "scheduled_frame"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "job_id": { "$ref": "#/$defs/id" },
        "status": { "$ref": "#/$defs/captureStatus" },
        "requested_frame": { "$ref": "#/$defs/u64" },
        "scheduled_frame": { "$ref": "#/$defs/u64" }
      }
    },
    "captureJobResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "job_id",
        "status",
        "requested_frame",
        "scheduled_frame",
        "captured_frame",
        "capture_id",
        "labelable",
        "has_preview",
        "error"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "job_id": { "$ref": "#/$defs/id" },
        "status": { "$ref": "#/$defs/captureStatus" },
        "requested_frame": { "$ref": "#/$defs/u64" },
        "scheduled_frame": { "$ref": "#/$defs/u64" },
        "captured_frame": {
          "oneOf": [{ "$ref": "#/$defs/u64" }, { "type": "null" }]
        },
        "capture_id": {
          "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        },
        "labelable": { "type": "boolean" },
        "has_preview": { "type": "boolean" },
        "error": {
          "oneOf": [{ "$ref": "#/$defs/errorObject" }, { "type": "null" }]
        }
      }
    },
    "labelRole": {
      "type": "string",
      "enum": [
        "first_boss",
        "goal_positive",
        "goal_negative",
        "needs_review",
        "rejected"
      ]
    },
    "targetLabelRole": {
      "type": "string",
      "enum": ["first_boss", "goal_positive", "goal_negative"]
    },
    "statusLabelRole": {
      "type": "string",
      "enum": ["needs_review", "rejected"]
    },
    "dedupRelation": {
      "type": "string",
      "enum": ["same_canonical_state", "distinct_stable_state"]
    },
    "captureSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_id",
        "frame",
        "status",
        "labelable",
        "has_preview",
        "labels",
        "created_at"
      ],
      "properties": {
        "capture_id": { "$ref": "#/$defs/id" },
        "frame": { "$ref": "#/$defs/u64" },
        "status": { "$ref": "#/$defs/captureStatus" },
        "labelable": { "type": "boolean" },
        "has_preview": { "type": "boolean" },
        "labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/labelRole" },
          "uniqueItems": true
        },
        "created_at": { "$ref": "#/$defs/rfc3339" }
      }
    },
    "captureRecentResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "captures", "next_cursor"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "captures": {
          "type": "array",
          "items": { "$ref": "#/$defs/captureSummary" }
        },
        "next_cursor": {
          "oneOf": [{ "type": "string" }, { "type": "null" }]
        }
      }
    },
    "captureDetailResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "capture_id",
        "frame",
        "status",
        "labelable",
        "has_preview",
        "preview_image_url",
        "privileged_features_available",
        "labels",
        "sanitized_provenance"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "capture_id": { "$ref": "#/$defs/id" },
        "frame": { "$ref": "#/$defs/u64" },
        "status": { "$ref": "#/$defs/captureStatus" },
        "labelable": { "type": "boolean" },
        "has_preview": { "type": "boolean" },
        "preview_image_url": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^/api/capture/[A-Za-z0-9._:-]+/preview(\\?frame=[0-9]+)?$"
            },
            { "type": "null" }
          ]
        },
        "privileged_features_available": { "type": "boolean" },
        "labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/labelRole" }
        },
        "sanitized_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capture_source", "layout_hash", "capture_spec_hash", "map_hash"],
          "properties": {
            "capture_source": { "enum": ["synthetic", "hypervisor"] },
            "layout_hash": { "$ref": "#/$defs/hashRef" },
            "capture_spec_hash": { "$ref": "#/$defs/hashRef" },
            "map_hash": { "$ref": "#/$defs/hashRef" }
          }
        }
      }
    },
    "captureFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._:-]*$"
        },
        "value": { "type": "number" }
      }
    },
    "captureFeaturesResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "capture_id", "available", "features"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "capture_id": { "$ref": "#/$defs/id" },
        "available": { "type": "boolean" },
        "features": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/captureFeature" }
        }
      }
    },
    "labelTargetSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_boss", "goal_positive", "goal_negative"],
      "properties": {
        "first_boss": {
          "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        },
        "goal_positive": {
          "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        },
        "goal_negative": {
          "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        }
      }
    },
    "statusLabelSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capture_id", "status"],
      "properties": {
        "capture_id": { "$ref": "#/$defs/id" },
        "status": { "$ref": "#/$defs/statusLabelRole" }
      }
    },
    "changedOffsetRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "len"],
      "properties": {
        "start": { "$ref": "#/$defs/u64" },
        "len": { "$ref": "#/$defs/u64" }
      }
    },
    "dedupGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group_id", "expected_relation", "capture_ids"],
      "anyOf": [
        { "required": ["changed_features"] },
        { "required": ["changed_offset_ranges"] }
      ],
      "properties": {
        "group_id": { "$ref": "#/$defs/id" },
        "expected_relation": { "$ref": "#/$defs/dedupRelation" },
        "capture_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "changed_features": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "changed_offset_ranges": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/changedOffsetRange" }
        },
        "status": {
          "type": "string",
          "enum": ["candidate", "confirmed", "conflict"]
        }
      }
    },
    "labelUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "capture_id", "role"],
      "properties": {
        "op": { "enum": ["upsert", "delete"] },
        "capture_id": { "$ref": "#/$defs/id" },
        "role": { "$ref": "#/$defs/labelRole" },
        "confidence": { "enum": ["candidate", "confirmed"] },
        "note": { "type": "string", "maxLength": 512 }
      }
    },
    "dedupUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "group_id"],
      "properties": {
        "op": { "enum": ["upsert", "delete"] },
        "group_id": { "$ref": "#/$defs/id" },
        "expected_relation": { "$ref": "#/$defs/dedupRelation" },
        "capture_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "changed_features": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9 _.-]+$"
          }
        },
        "changed_offset_ranges": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/changedOffsetRange" }
        },
        "status": {
          "type": "string",
          "enum": ["candidate", "confirmed", "conflict"]
        }
      }
    },
    "labelsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "session_id", "idempotency_key", "updates"],
      "anyOf": [
        { "properties": { "updates": { "minItems": 1 } } },
        {
          "required": ["dedup_updates"],
          "properties": { "dedup_updates": { "minItems": 1 } }
        }
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "session_id": { "$ref": "#/$defs/id" },
        "idempotency_key": { "$ref": "#/$defs/uuid" },
        "updates": {
          "type": "array",
          "items": { "$ref": "#/$defs/labelUpdate" }
        },
        "dedup_updates": {
          "type": "array",
          "items": { "$ref": "#/$defs/dedupUpdate" }
        }
      }
    },
    "labelsResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "applied", "label_revision", "conflicts"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "applied": { "type": "boolean" },
        "label_revision": { "type": "integer", "minimum": 0 },
        "conflicts": {
          "type": "array",
          "items": { "$ref": "#/$defs/errorObject" }
        }
      }
    },
    "labelsSnapshotResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "label_revision", "target_labels", "status_labels", "dedup_groups"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "label_revision": { "type": "integer", "minimum": 0 },
        "target_labels": { "$ref": "#/$defs/labelTargetSnapshot" },
        "status_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/statusLabelSnapshot" }
        },
        "dedup_groups": {
          "type": "array",
          "items": { "$ref": "#/$defs/dedupGroup" }
        }
      }
    },
    "wsMessageType": {
      "type": "string",
      "enum": [
        "input_state",
        "input_ack",
        "input_reject",
        "session_updated",
        "run_updated",
        "capture_updated",
        "label_updated",
        "validation_updated"
      ]
    },
    "inputSource": {
      "type": "string",
      "enum": ["keyboard", "gamepad", "combined"]
    },
    "padButton": {
      "type": "string",
      "enum": ["A", "B", "X", "Y", "L", "R", "Up", "Down", "Left", "Right", "Start", "Select"]
    },
    "wsEnvelope": {
      "oneOf": [
        { "$ref": "#/$defs/wsInputStateMessage" },
        { "$ref": "#/$defs/wsInputAckMessage" },
        { "$ref": "#/$defs/wsInputRejectMessage" },
        { "$ref": "#/$defs/wsSessionUpdatedMessage" },
        { "$ref": "#/$defs/wsRunUpdatedMessage" },
        { "$ref": "#/$defs/wsCaptureUpdatedMessage" },
        { "$ref": "#/$defs/wsLabelUpdatedMessage" },
        { "$ref": "#/$defs/wsValidationUpdatedMessage" }
      ]
    },
    "wsInputStateMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "type", "session_id", "client_seq", "source_id", "server_seq", "payload"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "type": { "const": "input_state" },
        "session_id": { "$ref": "#/$defs/id" },
        "client_seq": { "$ref": "#/$defs/u64" },
        "source_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "server_seq": { "type": "null" },
        "payload": { "$ref": "#/$defs/inputStatePayload" }
      }
    },
    "wsInputAckMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "type", "session_id", "client_seq", "source_id", "server_seq", "payload"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "type": { "const": "input_ack" },
        "session_id": { "$ref": "#/$defs/id" },
        "client_seq": { "$ref": "#/$defs/u64" },
        "source_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "server_seq": { "oneOf": [{ "$ref": "#/$defs/u64" }, { "type": "null" }] },
        "payload": { "$ref": "#/$defs/inputAckPayload" }
      }
    },
    "wsInputRejectMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "type", "session_id", "client_seq", "source_id", "server_seq", "payload"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "type": { "const": "input_reject" },
        "session_id": { "$ref": "#/$defs/id" },
        "client_seq": { "$ref": "#/$defs/u64" },
        "source_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "server_seq": { "oneOf": [{ "$ref": "#/$defs/u64" }, { "type": "null" }] },
        "payload": { "$ref": "#/$defs/errorEnvelope" }
      }
    },
    "wsSessionUpdatedMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "type", "session_id", "client_seq", "source_id", "server_seq", "payload"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "type": { "const": "session_updated" },
        "session_id": { "$ref": "#/$defs/id" },
        "client_seq": { "type": "null" },
        "source_id": { "const": "server" },
        "server_seq": { "$ref": "#/$defs/u64" },
        "payload": { "$ref": "#/$defs/sessionUpdatedPayload" }
      }
    },
    "wsRunUpdatedMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "type", "session_id", "client_seq", "source_id", "server_seq", "payload"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "type": { "const": "run_updated" },
        "session_id": { "$ref": "#/$defs/id" },
        "client_seq": { "type": "null" },
        "source_id": { "const": "server" },
        "server_seq": { "$ref": "#/$defs/u64" },
        "payload": { "$ref": "#/$defs/runUpdatedPayload" }
      }
    },
    "wsCaptureUpdatedMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "type", "session_id", "client_seq", "source_id", "server_seq", "payload"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "type": { "const": "capture_updated" },
        "session_id": { "$ref": "#/$defs/id" },
        "client_seq": { "type": "null" },
        "source_id": { "const": "server" },
        "server_seq": { "$ref": "#/$defs/u64" },
        "payload": { "$ref": "#/$defs/captureUpdatedPayload" }
      }
    },
    "wsLabelUpdatedMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "type", "session_id", "client_seq", "source_id", "server_seq", "payload"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "type": { "const": "label_updated" },
        "session_id": { "$ref": "#/$defs/id" },
        "client_seq": { "type": "null" },
        "source_id": { "const": "server" },
        "server_seq": { "$ref": "#/$defs/u64" },
        "payload": { "$ref": "#/$defs/labelUpdatedPayload" }
      }
    },
    "wsValidationUpdatedMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "type", "session_id", "client_seq", "source_id", "server_seq", "payload"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "type": { "const": "validation_updated" },
        "session_id": { "$ref": "#/$defs/id" },
        "client_seq": { "type": "null" },
        "source_id": { "const": "server" },
        "server_seq": { "$ref": "#/$defs/u64" },
        "payload": { "$ref": "#/$defs/validationUpdatedPayload" }
      }
    },
    "inputStatePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_event_id", "client_time_ms", "source", "buttons"],
      "properties": {
        "client_event_id": { "$ref": "#/$defs/uuid" },
        "client_time_ms": { "type": "number", "minimum": 0 },
        "source": { "$ref": "#/$defs/inputSource" },
        "buttons": {
          "type": "array",
          "items": { "$ref": "#/$defs/padButton" },
          "uniqueItems": true
        }
      }
    },
    "inputAckPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_event_id", "assigned_frame", "pad_word", "status"],
      "properties": {
        "client_event_id": { "$ref": "#/$defs/uuid" },
        "assigned_frame": { "$ref": "#/$defs/u64" },
        "pad_word": { "type": "integer", "minimum": 0, "maximum": 4095 },
        "status": { "enum": ["applied", "queued", "dropped"] }
      }
    },
    "captureUpdatedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "status", "capture_id"],
      "properties": {
        "job_id": { "$ref": "#/$defs/id" },
        "status": { "$ref": "#/$defs/captureStatus" },
        "capture_id": {
          "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        }
      }
    },
    "sessionUpdatedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "backend_mode", "current_frame", "capabilities"],
      "properties": {
        "state": { "$ref": "#/$defs/sessionState" },
        "backend_mode": { "$ref": "#/$defs/backendMode" },
        "current_frame": { "$ref": "#/$defs/u64" },
        "capabilities": { "$ref": "#/$defs/capabilities" }
      }
    },
    "runUpdatedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "current_frame", "preview_stale", "active_capture_job_id"],
      "properties": {
        "state": { "$ref": "#/$defs/sessionState" },
        "current_frame": { "$ref": "#/$defs/u64" },
        "preview_stale": { "type": "boolean" },
        "active_capture_job_id": {
          "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        }
      }
    },
    "labelUpdatedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label_revision", "applied"],
      "properties": {
        "label_revision": { "type": "integer", "minimum": 0 },
        "applied": { "type": "boolean" }
      }
    },
    "validationUpdatedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "command_class",
        "started_at",
        "completed_at",
        "summary",
        "issue_summaries"
      ],
      "properties": {
        "status": { "$ref": "#/$defs/validationStatus" },
        "command_class": {
          "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        },
        "started_at": {
          "oneOf": [{ "$ref": "#/$defs/rfc3339" }, { "type": "null" }]
        },
        "completed_at": {
          "oneOf": [{ "$ref": "#/$defs/rfc3339" }, { "type": "null" }]
        },
        "summary": {
          "type": "string",
          "maxLength": 240
        },
        "issue_summaries": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    }
  }
}
